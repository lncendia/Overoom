{
  "MongoDB": {
    "ApplicationDB": "Rooms",
    "MassTransitDB": "MassTransit"
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "rooms",
    "SignalR": [
      "/room"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{SourceContext} {Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Args": {
          "path": "logs/log_.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyy-MM-dd HH:mm:ss} [{SourceContext} {Level}] {Message}{NewLine}{Exception}"
        },
        "Name": "File"
      }
    ]
  }
}
