{
  "MongoDB": {
    "OpenIdDB": "OpenId",
    "IdentityDB": "Identity",
    "CacheDB": "Cache",
    "MassTransitDB": "MassTransit",
    "DataProtectionDB": "DataProtection"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{SourceContext} {Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Args": {
          "path": "logs/log_.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyy-MM-dd HH:mm:ss} [{SourceContext} {Level}] {Message}{NewLine}{Exception}"
        },
        "Name": "File"
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  }
}
