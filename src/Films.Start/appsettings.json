{
  "MongoDB": {
    "ApplicationDB": "Films",
    "MassTransitDB": "MassTransit"
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "films"
  },
  "Swagger": {
    "ClientId": "swagger",
    "ClientName": "Swagger UI",
    "Title": "Films",
    "Version": "v1",
    "Scopes": [
      {
        "Name": "films",
        "Description": "Доступ к библиотеке фильмов"
      }
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{SourceContext} {Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Args": {
          "path": "logs/log_.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyy-MM-dd HH:mm:ss} [{SourceContext} {Level}] {Message}{NewLine}{Exception}"
        },
        "Name": "File"
      }
    ]
  }
}
